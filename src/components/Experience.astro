---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:px-24 lg:py-16">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-4xl xl:text-5xl [overflow-wrap:anywhere] font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              {siteConfig.experience.map((exp, index) => (
                <>
                {exp.group && (
                  <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-6">
                    {exp.group}
                  </h3>
                )}
                <div class="relative mb-10 last:mb-0">
                  {/* Timeline dot at top of card */}
                  <div
                    class="absolute left-1/2 -top-2 w-4 h-4 bg-white border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300"
                    style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                  />

                  {/* Connecting line below card */}
                  {index < siteConfig.experience.length - 1 && !siteConfig.experience[index + 1].group && (
                    <div class="absolute left-1/2 bottom-0 w-0.5 h-10 bg-gray-300 -translate-x-1/2 translate-y-full z-10" />
                  )}

                  {/* Experience card */}
                  <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-4 sm:gap-x-8">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                          {exp.title}
                        </h3>
                        <p
                          class="text-base sm:text-lg"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span class="text-xs text-gray-500 mt-2 sm:mt-0 sm:text-right sm:max-w-[12.5rem] sm:text-balance sm:shrink-0">
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm sm:text-base text-gray-600">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                </>
              ))}
              {siteConfig.otherExperience && (
                <>
                  <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mt-12 mb-6">
                    {siteConfig.otherExperience.heading}
                  </h3>
                  <div class="relative">
                    <div
                      class="absolute left-1/2 -top-2 w-4 h-4 bg-white border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300"
                      style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                    />
                    <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                      <ul class="divide-y divide-gray-100">
                        {siteConfig.otherExperience.roles.map((role) => (
                          <li class="py-4 first:pt-0 last:pb-0">
                            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-8">
                              <div>
                                <h4 class="text-base sm:text-lg font-semibold text-gray-900">
                                  {role.title}
                                </h4>
                                <p
                                  class="text-sm sm:text-base"
                                  style={`color: ${siteConfig.accentColor}`}
                                >
                                  {role.company}
                                </p>
                              </div>
                              <span class="text-xs text-gray-500 mt-1 sm:mt-0 sm:text-right sm:shrink-0">
                                {role.dateRange}
                              </span>
                            </div>
                            <p class="mt-2 text-sm sm:text-base leading-relaxed text-pretty text-gray-600">
                              {role.description}
                            </p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
