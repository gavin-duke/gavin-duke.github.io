---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

// Optional per-project screenshots (see PORTFOLIO-SETUP.md). width/height are the
// image's real pixel size and are used only to preserve its aspect ratio.
type Screenshot = {
  src: string;
  alt: string;
  width: number;
  height: number;
  // Optional flat device frame drawn in CSS around the image.
  frame?: "iphone" | "macbook";
};
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:px-24 lg:py-16">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-4xl xl:text-5xl [overflow-wrap:anywhere] font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const screenshots =
                  (project as { screenshots?: Screenshot[] }).screenshots ?? [];
                const linkProps = project.link
                  ? {
                      href: project.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                        project.link
                          ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                          : "project-card-static"
                      }`}
                    >
                      {project.link && (
                        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div>
                          <span
                            class="text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            0{index + 1}
                          </span>
                          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
                            {project.name}
                          </h3>
                          {project.subtitle && (
                            <p class="text-base sm:text-lg text-gray-600 mt-1">
                              {project.subtitle}
                            </p>
                          )}
                          {project.status && (
                            <p class="text-sm text-gray-500 mt-1">
                              {project.status}
                            </p>
                          )}
                        </div>

                        <p
                          class={`text-base sm:text-lg text-gray-600 leading-relaxed text-pretty ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                        >
                          {project.description}
                        </p>

                        {screenshots.length > 1 && (
                          <div
                            data-gallery
                            role="group"
                            aria-roledescription="carousel"
                            aria-label={`${project.name} screenshots`}
                            class="relative py-2"
                          >
                            <div
                              data-track
                              tabindex="0"
                              class="flex overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)] rounded-lg"
                            >
                              {screenshots.map((shot) => (
                                <div class="snap-center shrink-0 w-full flex justify-center">
                                  {shot.frame === "iphone" ? (
                                    <div class="relative inline-flex rounded-[34px] bg-black p-[5px] ring-1 ring-gray-400 shadow-md">
                                      <img
                                        src={shot.src}
                                        alt={shot.alt}
                                        width={shot.width}
                                        height={shot.height}
                                        loading="eager"
                                        decoding="sync"
                                        class="block h-[370px] md:h-[410px] w-auto rounded-[29px]"
                                      />
                                      <span aria-hidden="true" class="absolute top-[13px] left-1/2 -translate-x-1/2 w-[28%] h-[11px] rounded-full bg-black" />
                                    </div>
                                  ) : (
                                    <img
                                      src={shot.src}
                                      alt={shot.alt}
                                      width={shot.width}
                                      height={shot.height}
                                      loading="eager"
                                      decoding="async"
                                      class="h-[380px] md:h-[420px] w-auto max-w-full object-contain rounded-lg border border-gray-200"
                                    />
                                  )}
                                </div>
                              ))}
                            </div>
                            {["prev", "next"].map((dir) => (
                              <button
                                type="button"
                                data-dir={dir}
                                aria-label={dir === "prev" ? "Previous screenshot" : "Next screenshot"}
                                class={`absolute top-1/2 -translate-y-1/2 ${dir === "prev" ? "left-2 sm:left-3" : "right-2 sm:right-3"} w-9 h-9 flex items-center justify-center rounded-full bg-gray-900 text-white hover:bg-gray-700 disabled:opacity-30 disabled:hover:bg-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]`}
                              >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={dir === "prev" ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7"} />
                                </svg>
                              </button>
                            ))}
                            <p data-count aria-live="polite" class="mt-3 text-center text-sm text-gray-500">
                              1 / {screenshots.length}
                            </p>
                          </div>
                        )}

                        {screenshots.length === 1 && (
                          screenshots[0].frame === "macbook" ? (
                            <div class="w-full">
                              <div class="relative mx-auto w-[94%] rounded-t-[12px] rounded-b-[3px] bg-black p-[6px] pt-[10px] ring-1 ring-gray-400">
                                <span aria-hidden="true" class="absolute top-[3px] left-1/2 -translate-x-1/2 w-[4px] h-[4px] rounded-full bg-gray-600" />
                                <img
                                  src={screenshots[0].src}
                                  alt={screenshots[0].alt}
                                  width={screenshots[0].width}
                                  height={screenshots[0].height}
                                  loading="eager"
                                  decoding="async"
                                  class="block w-full h-auto rounded-[2px]"
                                />
                              </div>
                              <div aria-hidden="true" class="relative h-[9px] w-full rounded-t-[2px] rounded-b-[14px] bg-gray-300">
                                <span class="absolute top-0 left-1/2 -translate-x-1/2 h-[4px] w-[16%] rounded-b-md bg-gray-400" />
                              </div>
                            </div>
                          ) : (
                            <img
                              src={screenshots[0].src}
                              alt={screenshots[0].alt}
                              width={screenshots[0].width}
                              height={screenshots[0].height}
                              loading="eager"
                              decoding="async"
                              class={`h-auto rounded-lg border border-gray-200 ${screenshots[0].height > screenshots[0].width ? "mx-auto max-h-[420px] w-auto" : "w-full"}`}
                            />
                          )
                        )}

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  project.link ? "group-hover:bg-gray-800" : ""
                                }`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Screenshot gallery: native scroll-snap handles swiping; buttons just move one slide.
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>("[data-track]")!;
    const prev = gallery.querySelector<HTMLButtonElement>('[data-dir="prev"]')!;
    const next = gallery.querySelector<HTMLButtonElement>('[data-dir="next"]')!;
    const count = gallery.querySelector<HTMLElement>("[data-count]")!;
    const total = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const update = () => {
      const i = current();
      prev.disabled = i <= 0;
      next.disabled = i >= total - 1;
      count.textContent = `${i + 1} / ${total}`;
    };
    const go = (step: number) => {
      const i = Math.min(total - 1, Math.max(0, current() + step));
      track.scrollTo({ left: i * track.clientWidth });
      update();
    };
    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>

<style define:vars={{ accent: siteConfig.accentColor }}>
  /* Subtle hover feedback for cards that are not links. Linked cards keep their own hover. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card-static {
      transition:
        transform 200ms ease-out,
        box-shadow 200ms ease-out,
        border-color 200ms ease-out;
    }
    .project-card-static:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--accent) 30%, #e5e7eb);
      box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.12);
    }
  }
</style>
